{
  "annotations": { "list": [] },
  "description": "Performance and resource metrics for kube-shard components: secondary API server (KAS), Kine storage layer, and PostgreSQL database.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Total SQL operations per second across all Kine query types, stacked by operation name.\n\n**Key operations:**\n- **GetSingleVal**: Point reads — the hottest path (watch + get)\n- **AfterAllOldVal**: Watch polling (list changes after a revision)\n- **CompactRev**: Revision compaction lookups\n- **Insert**: Writes (create/update/delete resources)\n- **ListCurrentVal**: List operations (informer initial list)\n- **GetRevisionAfterVal**: Watch continuation queries\n- **CountCurrent**: Count queries\n- **GetSize**: Database size checks\n- **Compact**: Actual compaction deletes",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never", "stacking": { "mode": "normal" } },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(kine_sql_total{namespace=\"$namespace\", error_code=\"\"}[5m])) by (name)",
          "legendFormat": "{{name}}"
        }
      ],
      "title": "SQL Operations Rate (by type)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "p50, p95, and p99 SQL query latencies across all operations. High latencies indicate PostgreSQL performance issues or connection pool saturation.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum(rate(kine_sql_time_seconds_bucket{namespace=\"$namespace\", error_code=\"\"}[5m])) by (le))",
          "legendFormat": "p50 (all ops)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum(rate(kine_sql_time_seconds_bucket{namespace=\"$namespace\", error_code=\"\"}[5m])) by (le))",
          "legendFormat": "p95 (all ops)"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum(rate(kine_sql_time_seconds_bucket{namespace=\"$namespace\", error_code=\"\"}[5m])) by (le))",
          "legendFormat": "p99 (all ops)"
        }
      ],
      "title": "SQL Latency Percentiles (All Operations)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Current total of successful compaction cycles. Compaction removes old revisions from the database to prevent unbounded growth.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }] }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 9 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(kine_compact_total{namespace=\"$namespace\", result=\"success\"})",
          "legendFormat": "compactions"
        }
      ],
      "title": "Total Compactions",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Rate of SQL errors. Error code 23505 is a PostgreSQL unique constraint violation (optimistic concurrency conflict) — these are expected and retried. Other errors may indicate database issues.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 1 }] }, "unit": "ops" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 9 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(kine_sql_total{namespace=\"$namespace\", error_code!=\"\"}[5m]))",
          "legendFormat": "errors/s"
        }
      ],
      "title": "SQL Error Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Insert errors not retried internally by Kine's serial-ID conflict loop. These are typically legitimate unique constraint violations (e.g., optimistic concurrency conflicts) that surface as HTTP 409 to the API server and are retried at a higher level. Non-zero values are normal under concurrent writes.",
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 1000 }] }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 9 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(kine_insert_errors_total{namespace=\"$namespace\", retriable=\"false\"})",
          "legendFormat": "non-retriable"
        }
      ],
      "title": "Non-Retriable Insert Errors",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 13 },
      "id": 101,
      "title": "Read Path — Watches & Gets power the Kubernetes informer cache. High latency here directly impacts controller responsiveness.",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Watch polling latency (AfterAllOldVal). This is the core watch loop query — Kine polls PostgreSQL for rows inserted after a given revision. p99 above 10ms under load warrants investigation.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 10,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.50, sum(rate(kine_sql_time_seconds_bucket{namespace=\"$namespace\", error_code=\"\", name=\"AfterAllOldVal\"}[5m])) by (le))", "legendFormat": "p50" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, sum(rate(kine_sql_time_seconds_bucket{namespace=\"$namespace\", error_code=\"\", name=\"AfterAllOldVal\"}[5m])) by (le))", "legendFormat": "p95" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.99, sum(rate(kine_sql_time_seconds_bucket{namespace=\"$namespace\", error_code=\"\", name=\"AfterAllOldVal\"}[5m])) by (le))", "legendFormat": "p99" }
      ],
      "title": "Watch Poll Latency (AfterAllOldVal)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Point-read latency (GetSingleVal). Used for individual resource GETs. This is the highest-volume operation — even small regressions multiply quickly.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 11,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.50, sum(rate(kine_sql_time_seconds_bucket{namespace=\"$namespace\", error_code=\"\", name=\"GetSingleVal\"}[5m])) by (le))", "legendFormat": "p50" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, sum(rate(kine_sql_time_seconds_bucket{namespace=\"$namespace\", error_code=\"\", name=\"GetSingleVal\"}[5m])) by (le))", "legendFormat": "p95" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.99, sum(rate(kine_sql_time_seconds_bucket{namespace=\"$namespace\", error_code=\"\", name=\"GetSingleVal\"}[5m])) by (le))", "legendFormat": "p99" }
      ],
      "title": "Get Latency (GetSingleVal)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "List operation latency (ListCurrentVal). Used by informer initial list and re-list after watch failures. High latency causes slow controller startup.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "id": 12,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.50, sum(rate(kine_sql_time_seconds_bucket{namespace=\"$namespace\", error_code=\"\", name=\"ListCurrentVal\"}[5m])) by (le))", "legendFormat": "p50" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, sum(rate(kine_sql_time_seconds_bucket{namespace=\"$namespace\", error_code=\"\", name=\"ListCurrentVal\"}[5m])) by (le))", "legendFormat": "p95" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.99, sum(rate(kine_sql_time_seconds_bucket{namespace=\"$namespace\", error_code=\"\", name=\"ListCurrentVal\"}[5m])) by (le))", "legendFormat": "p99" }
      ],
      "title": "List Latency (ListCurrentVal)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Read operation rates broken down by type. Helps identify which read path is under pressure.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never", "stacking": { "mode": "normal" } },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "id": 13,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(kine_sql_total{namespace=\"$namespace\", error_code=\"\", name=~\"GetSingleVal|AfterAllOldVal|ListCurrentVal|CountCurrent|GetRevisionAfterVal\"}[5m])) by (name)",
          "legendFormat": "{{name}}"
        }
      ],
      "title": "Read Operations Rate (by type)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "id": 102,
      "title": "Write Path — Inserts create new revisions for resource creates/updates/deletes. Write latency directly impacts kubectl apply and controller reconciliation speed.",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Insert latency percentiles. Each Kubernetes write (create, update, delete) becomes one or more Insert operations. p99 above 50ms under load may indicate PostgreSQL write contention.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "id": 20,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.50, sum(rate(kine_sql_time_seconds_bucket{namespace=\"$namespace\", error_code=\"\", name=\"Insert\"}[5m])) by (le))", "legendFormat": "p50" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, sum(rate(kine_sql_time_seconds_bucket{namespace=\"$namespace\", error_code=\"\", name=\"Insert\"}[5m])) by (le))", "legendFormat": "p95" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.99, sum(rate(kine_sql_time_seconds_bucket{namespace=\"$namespace\", error_code=\"\", name=\"Insert\"}[5m])) by (le))", "legendFormat": "p99" }
      ],
      "title": "Insert Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Insert rate vs conflict rate. Conflicts (error 23505) are expected under concurrent writes — Kine uses optimistic locking. A high conflict ratio (>10%) means heavy write contention on the same keys.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "id": 21,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(kine_sql_total{namespace=\"$namespace\", error_code=\"\", name=\"Insert\"}[5m]))",
          "legendFormat": "successful inserts/s"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(kine_sql_total{namespace=\"$namespace\", error_code=\"23505\", name=\"Insert\"}[5m]))",
          "legendFormat": "conflicts (23505)/s"
        }
      ],
      "title": "Insert Rate vs Conflicts",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 },
      "id": 103,
      "title": "Compaction — Removes old revisions to prevent database bloat. If compaction falls behind, the kine table grows unbounded, degrading query performance.",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Compaction rate — how often compaction cycles run. Should be steady. Drops indicate compaction is stalled or the process is unhealthy.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 40 },
      "id": 30,
      "options": { "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(kine_compact_total{namespace=\"$namespace\", result=\"success\"}[5m]))",
          "legendFormat": "compactions/s"
        }
      ],
      "title": "Compaction Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Compaction SQL latency. The Compact operation deletes old rows, CompactRev looks up which revisions to compact. Rising latency means the table is growing or indexes need maintenance.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 40 },
      "id": 31,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.99, sum(rate(kine_sql_time_seconds_bucket{namespace=\"$namespace\", error_code=\"\", name=\"Compact\"}[5m])) by (le))", "legendFormat": "Compact p99" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.99, sum(rate(kine_sql_time_seconds_bucket{namespace=\"$namespace\", error_code=\"\", name=\"CompactRev\"}[5m])) by (le))", "legendFormat": "CompactRev p99" }
      ],
      "title": "Compaction Latency (p99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Ratio of insert rate to compaction rate. If this ratio grows over time, compaction is not keeping up with writes and the database will bloat.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 40 },
      "id": 32,
      "options": { "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(kine_sql_total{namespace=\"$namespace\", error_code=\"\", name=\"GetSize\"}[5m]))",
          "legendFormat": "GetSize calls/s"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(kine_sql_total{namespace=\"$namespace\", error_code=\"\", name=\"Insert\"}[5m])) / (sum(rate(kine_sql_total{namespace=\"$namespace\", error_code=\"\", name=\"Compact\"}[5m])) > 0)",
          "legendFormat": "insert/compact ratio"
        }
      ],
      "title": "Insert to Compact Ratio",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 },
      "id": 104,
      "title": "Resources — Container-level resource usage for Kine pods",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Goroutine count over time. A steady upward trend indicates a goroutine leak.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 49 },
      "id": 40,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "go_goroutines{namespace=\"$namespace\", job=~\".*kine.*\"}",
          "legendFormat": "{{pod}}"
        }
      ],
      "title": "Goroutines (over time)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Container memory working set per Kine pod. Compare with resource limits to assess headroom.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 49 },
      "id": 41,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(container_memory_working_set_bytes{namespace=\"$namespace\", container=\"kine\"}) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ],
      "title": "Kine Memory (Working Set)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Container CPU usage per Kine pod in cores.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" },
          "unit": "short",
          "custom.axisLabel": "cores"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 49 },
      "id": 42,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container=\"kine\"}[5m])) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ],
      "title": "Kine CPU Usage",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 57 },
      "id": 105,
      "title": "Secondary API Server (KAS) — The aggregated kube-apiserver serving sharded API groups. Resource pressure here affects all API requests for sharded resources.",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Container memory working set per KAS pod. Compare with resource limits to assess OOM risk. The secondary KAS caches informer data and holds open watch connections.",
      "fieldConfig": {
        "defaults": {
